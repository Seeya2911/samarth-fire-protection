{
  "name": "samarth-fire-website",
  "version": "1.0.0",
  "description": "Website for Samarth Fire Protection System",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build:html": "node build.js",
    "build": "npm run build:css && npm run images && npm run build:html",
    "images": "node scripts/optimize_images.js",
    "test": "node scripts/verify_release_gate.js && node scripts/audit_site.js",
    "start": "node scripts/server.js"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
